{
  "name": "echoes-of-the-basement",
  "version": "0.0.0",
  "description": "A mod for The Binding of Isaac: Repentance.",
  "keywords": [
    "isaac",
    "mod",
    "rebirth",
    "afterbirth",
    "repentance"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "tstl",
    "check:assets": "node ./scripts/checkAssets.mjs",
    "lint": "tsx ./scripts/lint.ts",
    "lint:strict": "tsx ./scripts/lint.ts --strict",
    "nuke": "isaacscript nuke",
    "publish": "isaacscript publish",
    "start": "isaacscript monitor",
    "update": "isaacscript update"
  },
  "dependencies": {
    "isaac-typescript-definitions": "43.0.6",
    "isaac-typescript-definitions-repentogon": "^3.0.0",
    "isaacscript-common": "87.9.6"
  },
  "devDependencies": {
    "complete-node": "16.4.1",
    "isaacscript": "6.0.2",
    "isaacscript-lint": "7.3.2",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.36.0"
  }
}
